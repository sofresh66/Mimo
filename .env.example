# ─────────────────────────────────────────────────────────────────────────────
# Mimo — variables d'environnement
# Copier ce fichier en `.env` (ou lancer `pnpm setup`, qui génère des secrets aléatoires).
# Ne JAMAIS committer le fichier `.env`.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
# Origine publique de l'application web (utilisée pour CORS et Socket.IO).
WEB_ORIGIN=http://localhost:3000
# URL interne de l'API, utilisée par Next.js pour proxifier /api et /socket.io.
API_INTERNAL_URL=http://localhost:4000
# Nom affiché (branding). Optionnel.
NEXT_PUBLIC_APP_NAME=Mimo

# ─── API (NestJS) ────────────────────────────────────────────────────────────
API_PORT=4000
DATABASE_URL=postgresql://mimo:mimo@localhost:5432/mimo?schema=public
# Développement et tests : TOUJOURS une base locale. Le seed, les tests et `db:migrate`/`db:reset`
# refusent toute base distante. Les URL de production ne vont que dans l'hébergeur (Render).
# Connexion directe (non poolée) utilisée par Prisma pour les migrations.
# En local : même valeur que DATABASE_URL. Avec Neon : DATABASE_URL = URL poolée (hôte « -pooler »),
# DIRECT_URL = URL directe (hôte sans « -pooler »).
DIRECT_URL=postgresql://mimo:mimo@localhost:5432/mimo?schema=public
# Base dédiée aux tests d'intégration (vidée par les tests !).
TEST_DATABASE_URL=postgresql://mimo:mimo@localhost:5432/mimo_test?schema=public
# Redis (cache, rate limiting, files BullMQ, adaptateur Socket.IO).
# Laisser vide pour utiliser les implémentations en mémoire (développement sans Docker).
REDIS_URL=redis://localhost:6379

# Secret de signature des JWT d'accès : au moins 32 caractères aléatoires.
JWT_ACCESS_SECRET=change-me-with-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Durée de validité de l'espace parent déverrouillé par PIN sur un appareil familial.
PARENT_MODE_TTL_MINUTES=30
# Tentatives de connexion / PIN autorisées par minute et par IP (10 recommandé en production ;
# valeur plus large en local pour les tests E2E qui se connectent souvent).
AUTH_RATE_LIMIT=10
# Lettres familiales envoyées par minute (limite simple, par adresse IP).
LETTER_RATE_LIMIT=10
# Cookies `Secure` (obligatoire en production derrière HTTPS).
COOKIE_SECURE=false

# Fuseau horaire utilisé pour découper les missions quotidiennes et hebdomadaires.
APP_TIMEZONE=Europe/Paris

# Accélère les explorations (1 = durée réelle, 0.1 = 10x plus rapide). Utile en démo/tests.
EXPLORATION_TIME_SCALE=1

# ─── Moteur Python (FastAPI) ─────────────────────────────────────────────────
ENGINE_URL=http://localhost:8000
ENGINE_PORT=8000
# Clé partagée entre l'API et le moteur (appels internes uniquement).
ENGINE_API_KEY=change-me-engine-key
